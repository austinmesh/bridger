# Bridger application environment variables
TZ=America/Chicago

# EMQX MQTT Broker configuration
# EMQX 5 removed allow_anonymous entirely. Clients are rejected unless they
# authenticate against the configured authenticator, so there is nothing to set.
EMQX_DEFAULT_LOG_HANDLER=console
# The certificates are generated by the certbot container and mounted into the EMQX container.
# Uncomment the following lines if you want to use SSL/TLS for MQTT and WebSocket connections
# and change the paths to match your certificate files.
# EMQX_LISTENERS__SSL__DEFAULT__SSL_OPTIONS__KEYFILE=/etc/letsencrypt/live/mqtt.yourdomain.com/privkey.pem
# EMQX_LISTENERS__SSL__DEFAULT__SSL_OPTIONS__CERTFILE=/etc/letsencrypt/live/mqtt.yourdomain.com/fullchain.pem
# EMQX_LISTENERS__WSS__DEFAULT__SSL_OPTIONS__KEYFILE=/etc/letsencrypt/live/mqtt.yourdomain.com/privkey.pem
# EMQX_LISTENERS__WSS__DEFAULT__SSL_OPTIONS__CERTFILE=/etc/letsencrypt/live/mqtt.yourdomain.com/fullchain.pem
EMQX_NODE__COOKIE=emqx_cookie_change_me # Change this to a secure value for production use
EMQX_HOST=emqx
EMQX_API_KEY="" # Generated from the bootstrap process, see README.md for details.
EMQX_SECRET_KEY="" # Generated from the bootstrap process, see README.md for details.

# Grafana configuration
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
GF_AUTH_ANONYMOUS_ORG_NAME="Bridger Mesh"
GF_AUTH_ANONYMOUS_HIDE_VERSION=true
GF_SECURITY_ALLOW_EMBEDDING=true
GF_SERVER_ROOT_URL=https://graphs.yourdomain.com/
GF_SERVER_PROTOCOL=https

# Certbot configuration
CERTBOT_EMAIL=you@yourdomain.com
CERTBOT_DOMAIN=mqtt.yourdomain.com

# MQTT client configuration
MQTT_TOPIC="local/egr/home/2/e/#"
MQTT_USER="bridger"
MQTT_PASS="br1dg3rp455"
# Suffixed per process (-bridger, -testmsg) so the two connections do not evict each other.
MQTT_CLIENT_ID="bridger"
# MQTT_BROKER=emqx
# MQTT_PORT=1883

# InfluxDB v2 configuration
INFLUXDB_V2_ORG="meshtastic"
INFLUXDB_V2_BUCKET="meshtastic"
INFLUXDB_V2_TOKEN="" # Generated from the bootstrap process, see README.md for details.
# INFLUXDB_V2_URL=http://influxdb:8086
# INFLUXDB_V2_WRITE_PRECISION=s   # s, ms, us or ns

# Discord Bot configuration. You only need to configure if you want to use the Discord bot.
DISCORD_BOT_TOKEN=""
DISCORD_BOT_OWNER_ID=""
TEST_MESSAGE_MATCH_ALL="false" # Set to true if you want to match all messages in the test message command.
# BRIDGER_ADMIN_ROLE="Bridger Admin"   # Discord role allowed to run admin commands
# MQTT_TEST_CHANNEL="+"                # Meshtastic channel the testmsg listener watches
# MQTT_TEST_CHANNEL_ID=""              # Discord channel ID it posts to

# Meshtastic
# MESHTASTIC_KEY="1PG7OiApB1nwvP+rz05pAQ=="  # base64 AES-128 PSK; default is the "AQ==" key
# MESHTASTIC_API_CACHE_TTL=21600
# MESHTASTIC_API_TIMEOUT=10

# EMQX management API, used by the Discord bot and CLI
# EMQX_URL=http://emqx:18083
# EMQX_HTTP_CONNECT_TIMEOUT=3.05
# EMQX_HTTP_READ_TIMEOUT=10

# Logging
# LOG_PATH=logs/bridger.log
LOGURU_LEVEL=INFO

# Sentry. SENTRY_DSN is read by the SDK itself; leave it unset to disable reporting.
# SENTRY_DSN=""
# SENTRY_RELEASE=development
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1

# Advanced tuning. The defaults are fine for a normal deployment.
#
# Discord bot caches. Autocomplete runs a 30-day InfluxDB query, so the node list is cached
# and refreshed in the background; the TTL is deliberately twice the refresh interval so a
# single failed refresh does not empty it.
# BRIDGER_NODE_CACHE_TTL=600
# BRIDGER_NODE_CACHE_REFRESH=300
# BRIDGER_GATEWAY_CACHE_TTL=30
# BRIDGER_NODE_INFO_CACHE_TTL=300
# BRIDGER_AUTOCOMPLETE_DEADLINE=2.0    # Discord allows roughly 3s
#
# testmsg MQTT supervisor backoff, in seconds.
# BRIDGER_MQTT_RESTART_MIN_DELAY=1
# BRIDGER_MQTT_RESTART_MAX_DELAY=300
# BRIDGER_MQTT_HEALTHY_SECONDS=60      # a run lasting this long resets the backoff
