[Unit]
Before = emqx.service

[Container]
HostName = certbot
# The deploy hook runs only when a certificate was actually renewed.
#
# chmod: EMQX runs as uid 1000 inside its container while certbot writes privkey.pem 0600 as
# container-root. Under rootless podman those are different subuids, so EMQX cannot read the
# key and its TLS listeners fail to start. The certbot-conf volume is mounted only by these
# two containers, so widening the mode is contained to that volume.
#
# The marker file is picked up by ExecStopPost below, which reloads EMQX's TLS listeners.
Exec = certonly --standalone --non-interactive --agree-tos -d mqtt.austinmesh.org --email andys@andyshinn.as --deploy-hook "chmod 0644 /etc/letsencrypt/archive/mqtt.austinmesh.org/privkey*.pem && touch /etc/letsencrypt/renewed"
PublishPort = 8094:80
Image = docker.io/certbot/certbot:v5.8.0
Volume = certbot-conf.volume:/etc/letsencrypt
Volume = certbot-data.volume:/var/lib/letsencrypt
Network = bridger.network

[Service]
Type = oneshot
RemainAfterExit = no
# Reload EMQX's TLS listeners only when the certificate actually changed, so gateways on
# 8883 are not disconnected on every timer run. The check goes through the emqx container
# because that is what has the volume mounted at a known path.
ExecStopPost = /bin/sh -c 'podman exec emqx test -f /etc/letsencrypt/renewed || exit 0; \
    podman exec emqx emqx ctl listeners restart ssl:default; \
    podman exec emqx emqx ctl listeners restart wss:default; \
    podman exec emqx rm -f /etc/letsencrypt/renewed'

[Install]
WantedBy = default.target
