logging {
  level  = "info"
  format = "logfmt"
}

local.file_match "bridger_logs" {
  path_targets = [
    {
      __path__ = "/var/lib/bridger/logs/bridger.log",
      job      = "bridger",
      service  = "bridger",
    },
    {
      __path__ = "/var/lib/bridger/logs/bot.log",
      job      = "bridger",
      service  = "bot",
    },
    {
      __path__ = "/var/lib/bridger/logs/http.log",
      job      = "bridger",
      service  = "http",
    },
  ]

  sync_period = "10s"
}

loki.source.file "bridger_logs" {
  targets    = local.file_match.bridger_logs.targets
  forward_to = [loki.process.bridger_parsing.receiver]
}

loki.process "bridger_parsing" {
  forward_to = [loki.write.default.receiver]

  stage.json {
    expressions = {
      record = "record",
      text = "text",
      message = "record.message",
      timestamp = "record.time.timestamp",
      extra = "record.extra",
      exception = "record.exception",
      level = "record.level.name",
      module = "record.module",
      function = "record.function",
      file = "record.file",
      line = "record.line",
      name = "record.name",
      process = "record.process",
      thread = "record.thread",
    }
  }

  stage.timestamp {
    source = "timestamp"
    format = "Unix"
  }

  stage.labels {
    values = {
      level = "level",
    }
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
